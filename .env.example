# Copy this file to .env and fill in your own values. Never commit the real .env.

# --- Shared Apple Music API auth -------------------------------------------
# Generate with Scripts/jwt_token_generate.py using your Apple Developer
# Program membership (MusicKit identifier + private key).
DEVELOPER_TOKEN=

# The token identifying your personal Apple Music library/account. Obtain via
# MusicKit JS (https://js-cdn.music.apple.com/musickit/v3/musickit.js) by
# authorizing once and reading `MusicKit.getInstance().musicUserToken`.
MUSIC_USER_TOKEN=

# --- Used by jwt_token_generate.py ------------------------------------------
KEY_ID=
TEAM_ID=
PRIVATE_KEY=path/to/AuthKey_XXXXXXXXXX.p8

# --- Used by Scripts/sync_playlists.py --------------------------------------
SOURCE_PLAYLIST_ID=
DESTINATION_PLAYLIST_ID=
WEBHOOK_URL=

# --- Used by Scripts/recommend.py -------------------------------------------
# Reuses SOURCE_PLAYLIST_ID above as the playlist your taste profile is built from.
